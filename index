                        <i class="fas fa-save ml-1"></i> حفظ السجل
                    </button>
                </div>
            </form>
        </div>

        <!-- جدول عرض السجلات -->
        <div class="bg-white rounded-xl shadow overflow-hidden">
            <div class="p-4 bg-slate-100 border-b flex justify-between items-center">
                <h3 class="font-bold text-slate-700"><i class="fas fa-table ml-2"></i> سجلات الإنتاج اليومية</h3>
                <button onclick="clearData()" class="text-red-600 text-sm hover:underline"><i class="fas fa-trash ml-1"></i> مسح كافة البيانات</button>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-right border-collapse">
                    <thead>
                        <tr class="bg-slate-50 text-slate-600 border-b text-sm">
                            <th class="p-3">التاريخ</th>
                            <th class="p-3">اسم الخياط</th>
                            <th class="p-3">عدد القطع</th>
                            <th class="p-3">الإجراء</th>
                        </tr>
                    </thead>
                    <tbody id="dataTableBody" class="divide-y text-sm">
                        <!-- تُضاف البيانات ديناميكياً هنا -->
                    </tbody>
                </table>
            </div>
        </div>

    </main>

    <!-- كود الجافاسكريبت للتشغيل التفاعلي -->
    <script>
        let records = JSON.parse(localStorage.getItem('tailor_records')) || [];

        const form = document.getElementById('entryForm');
        const tableBody = document.getElementById('dataTableBody');
        const totalPiecesEl = document.getElementById('totalPieces');
        const totalButtonLabEl = document.getElementById('totalButtonLab');
        const totalTailorsEl = document.getElementById('totalTailors');

        function updateUI() {
            tableBody.innerHTML = '';
            let totalPieces = 0;

            if (records.length === 0) {
                tableBody.innerHTML = `<tr><td colspan="4" class="text-center p-4 text-gray-400">لا توجد سجلات مسجلة حتى الآن</td></tr>`;
            }

            records.forEach((rec, index) => {
                totalPieces += Number(rec.pieces);
                const row = document.tr = document.createElement('tr');
                row.className = "hover:bg-gray-50";
                row.innerHTML = `
                    <td class="p-3">${rec.date}</td>
                    <td class="p-3 font-semibold text-slate-700">${rec.tailor}</td>
                    <td class="p-3">${rec.pieces}</td>
                    <td class="p-3"><button onclick="deleteRecord(${index})" class="text-red-500 hover:text-red-700"><i class="fas fa-trash-alt"></i></button></td>
                `;
                tableBody.appendChild(row);
            });

            totalPiecesEl.innerText = totalPieces;
            totalButtonLabEl.innerText = totalPieces * 5; // افتراض حساب معمل الزرار
            totalTailorsEl.innerText = totalPieces * 15; // افتراض حساب مستحقات الخياطين
            localStorage.setItem('tailor_records', JSON.stringify(records));
        }

        form.addEventListener('submit', (e) => {
            e.preventDefault();
            const date = document.getElementById('entryDate').value;
            const tailor = document.getElementById('tailorName').value;
            const pieces = document.getElementById('piecesCount').value;

            records.push({ date, tailor, pieces });
            form.reset();
            document.getElementById('entryDate').valueAsDate = new Date();
            updateUI();
        });

        function deleteRecord(index) {
            records.splice(index, 1);
            updateUI();
        }

        function clearData() {
            if (confirm('هل أنت متأكد من مسح كافة البيانات؟')) {
                records = [];
                updateUI();
            }
        }

        // تعيين تاريخ اليوم كافتراضي عند الفتح
        document.getElementById('entryDate').valueAsDate = new Date();
        updateUI();
    </script>
</body>
</html>
