<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>النظام الشامل - معمل أسلوب الأناقة</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome للأيقونات -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Cairo', sans-serif; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
    </style>
</head>
<body class="bg-gray-100 text-gray-800">

    <!-- شريط التنقل العلوي -->
    <header class="bg-slate-900 text-white shadow-lg sticky top-0 z-50">
        <div class="container mx-auto px-4 py-3 flex flex-col sm:flex-row justify-between items-center">
            <h1 class="text-lg font-bold flex items-center gap-2">
                <i class="fas fa-cut text-amber-400"></i> معمل أسلوب الأناقة
            </h1>
            <span class="text-xs text-gray-400 mt-1 sm:mt-0">نظام الإدارة المالي والإنتاجي (2026 - 2028)</span>
        </div>
        <!-- أزرار التبويبات -->
        <nav class="bg-slate-800 border-t border-slate-700 px-4 flex overflow-x-auto gap-2 py-2">
            <button onclick="switchTab('home')" id="btn-home" class="tab-btn px-4 py-2 text-sm font-semibold rounded-lg bg-amber-500 text-slate-900 transition flex items-center gap-2 whitespace-nowrap">
                <i class="fas fa-home"></i> الرئيسية والملخص
            </button>
            <button onclick="switchTab('daily')" id="btn-daily" class="tab-btn px-4 py-2 text-sm font-semibold rounded-lg text-gray-300 hover:bg-slate-700 transition flex items-center gap-2 whitespace-nowrap">
                <i class="fas fa-calendar-alt"></i> الإنتاج اليومي
            </button>
            <button onclick="switchTab('tailors')" id="btn-tailors" class="tab-btn px-4 py-2 text-sm font-semibold rounded-lg text-gray-300 hover:bg-slate-700 transition flex items-center gap-2 whitespace-nowrap">
                <i class="fas fa-users"></i> حسابات الخياطين
            </button>
            <button onclick="switchTab('buttons')" id="btn-buttons" class="tab-btn px-4 py-2 text-sm font-semibold rounded-lg text-gray-300 hover:bg-slate-700 transition flex items-center gap-2 whitespace-nowrap">
                <i class="fas fa-circle-dot"></i> معمل الزرار
            </button>
        </nav>
    </header>

    <!-- المحتوى الرئيسي -->
    <main class="container mx-auto px-4 py-6 max-w-6xl">
        
        <!-- تبويب الرئيسية والملخص -->
        <section id="home" class="tab-content active space-y-6">
            <div class="bg-gradient-to-r from-slate-800 to-slate-900 text-white rounded-2xl p-6 shadow-xl">
                <h2 class="text-xl font-bold mb-2">مرحباً بك في نظام إدارة معمل أسلوب الأناقة</h2>
                <p class="text-sm text-gray-300">إدارة دقيقة لقطع المعمل، مستحقات الخياطين (عبد الله، إدريس، رام، سبدول، نارش، سجاد، إرشاد، بدرول)، وحسابات معمل الزرار.</p>
            </div>

            <!-- بطاقات الإحصائيات -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="bg-white p-5 rounded-xl shadow border-r-4 border-blue-600">
                    <p class="text-sm text-gray-500">إجمالي قطع المعمل كاملة</p>
                    <h3 id="homeTotalPieces" class="text-3xl font-bold text-slate-800 mt-1">0</h3>
                </div>
                <div class="bg-white p-5 rounded-xl shadow border-r-4 border-amber-500">
                    <p class="text-sm text-gray-500">إجمالي مستحقات الخياطين</p>
                    <h3 id="homeTotalTailors" class="text-3xl font-bold text-slate-800 mt-1">0</h3>
                </div>
                <div class="bg-white p-5 rounded-xl shadow border-r-4 border-emerald-600">
                    <p class="text-sm text-gray-500">صافي حساب معمل الزرار</p>
                    <h3 id="homeTotalButtons" class="text-3xl font-bold text-slate-800 mt-1">0</h3>
                </div>
            </div>
        </section>

        <!-- تبويب الإنتاج اليومي -->
        <section id="daily" class="tab-content space-y-6">
            <div class="bg-white rounded-xl shadow p-5">
                <h2 class="text-lg font-bold mb-4 text-slate-700 flex items-center gap-2">
                    <i class="fas fa-plus-circle text-blue-600"></i> تسجيل إنتاج يومي جديد
                </h2>
                <form id="entryForm" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div>
                        <label class="block text-sm font-semibold mb-1">التاريخ</label>
                        <input type="date" id="entryDate" required class="w-full border rounded-lg p-2 focus:ring-2 focus:ring-blue-400 outline-none">
                    </div>
                    <div>
                        <label class="block text-sm font-semibold mb-1">اسم الخياط</label>
                        <select id="tailorName" class="w-full border rounded-lg p-2 focus:ring-2 focus:ring-blue-400 outline-none">
                            <option value="عبد الله">عبد الله</option>
                            <option value="إدريس">إدريس</option>
                            <option value="رام">رام</option>
                            <option value="سبدول">سبدول</option>
                            <option value="نارش">نارش</option>
                            <option value="سجاد">سجاد</option>
                            <option value="إرشاد">إرشاد</option>
                            <option value="بدرول">بدرول</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold mb-1">عدد القطع</label>
                        <input type="number" id="piecesCount" min="1" value="1" required class="w-full border rounded-lg p-2 focus:ring-2 focus:ring-blue-400 outline-none">
                    </div>
                    <div class="flex items-end">
                        <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold p-2.5 rounded-lg transition duration-200">
                            <i class="fas fa-save ml-1"></i> حفظ السجل
                        </button>
                    </div>
                </form>
            </div>

            <!-- جدول عرض السجلات -->
            <div class="bg-white rounded-xl shadow overflow-hidden">
                <div class="p-4 bg-slate-50 border-b flex justify-between items-center">
                    <h3 class="font-bold text-slate-700"><i class="fas fa-table ml-2"></i> السجلات اليومية</h3>
                    <button onclick="clearData()" class="text-red-600 text-sm hover:underline"><i class="fas fa-trash ml-1"></i> مسح الكل</button>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-right border-collapse">
                        <thead>
                            <tr class="bg-slate-100 text-slate-600 border-b text-sm">
                                <th class="p-3">التاريخ</th>
                                <th class="p-3">الخياط</th>
                                <th class="p-3">عدد القطع</th>
                                <th class="p-3">الإجراء</th>
                            </tr>
                        </thead>
                        <tbody id="dataTableBody" class="divide-y text-sm"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- تبويب حسابات الخياطين -->
        <section id="tailors" class="tab-content space-y-6">
            <div class="bg-white rounded-xl shadow p-5">
                <h2 class="text-lg font-bold mb-4 text-slate-700"><i class="fas fa-users-cog ml-2"></i> ملخص إنتاج ومستحقات الخياطين</h2>
                <div class="overflow-x-auto">
                    <table class="w-full text-right border-collapse">
                        <thead>
                            <tr class="bg-slate-100 text-slate-600 border-b text-sm">
                                <th class="p-3">اسم الخياط</th>
                                <th class="p-3">إجمالي القطع المنتجة</th>
                                <th class="p-3">المستحقات التقديرية</th>
                            </tr>
                        </thead>
                        <tbody id="tailorsSummaryBody" class="divide-y text-sm"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- تبويب معمل الزرار -->
        <section id="buttons" class="tab-content space-y-6">
            <div class="bg-white rounded-xl shadow p-5">
                <h2 class="text-lg font-bold mb-4 text-slate-700"><i class="fas fa-circle-dot ml-2"></i> حسابات معمل الزرار</h2>
                <div class="p-4 bg-emerald-50 border border-emerald-200 rounded-xl">
                    <p class="text-sm text-emerald-800">إجمالي قطع المعمل المرتبطة بمعمل الزرار:</p>
                    <h3 id="buttonLabTotal" class="text-3xl font-bold text-emerald-900 mt-2">0 قطعه</h3>
                </div>
            </div>
        </section>

    </main>

    <!-- الجافاسكريبت والتحكم بالتبويبات والبيانات -->
    <script>
        let records = JSON.parse(localStorage.getItem('tailor_records')) || [];
        const tailorsList = ["عبد الله", "إدريس", "رام", "سبدول", "نارش", "سجاد", "إرشاد", "بدرول"];

        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(el => {
                el.classList.remove('bg-amber-500', 'text-slate-900');
                el.classList.add('text-gray-300', 'hover:bg-slate-700');
            });

            document.getElementById(tabId).classList.add('active');
            const activeBtn = document.getElementById(`btn-${tabId}`);
            activeBtn.classList.remove('text-gray-300', 'hover:bg-slate-700');
            activeBtn.classList.add('bg-amber-500', 'text-slate-900');
        }

        const form = document.getElementById('entryForm');
        const tableBody = document.getElementById('dataTableBody');

        function updateUI() {
            tableBody.innerHTML = '';
            let totalPieces = 0;
            let tailorsTotals = {};
            tailorsList.forEach(t => tailorsTotals[t] = 0);

            if (records.length === 0) {
                tableBody.innerHTML = `<tr><td colspan="4" class="text-center p-4 text-gray-400">لا توجد سجلات مسجلة</td></tr>`;
            }

            records.forEach((rec, index) => {
                const p = Number(rec.pieces);
                totalPieces += p;
                if(tailorsTotals[rec.tailor] !== undefined) {
                    tailorsTotals[rec.tailor] += p;
                }

                const row = document.createElement('tr');
                row.className = "hover:bg-gray-50";
                row.innerHTML = `
                    <td class="p-3">${rec.date}</td>
                    <td class="p-3 font-semibold text-slate-700">${rec.tailor}</td>
                    <td class="p-3">${p}</td>
                    <td class="p-3"><button onclick="deleteRecord(${index})" class="text-red-500 hover:text-red-700"><i class="fas fa-trash-alt"></i></button></td>
                `;
                tableBody.appendChild(row);
            });

            // تحديث بطاقات الرئيسية
            document.getElementById('homeTotalPieces').innerText = totalPieces;
            document.getElementById('homeTotalTailors').innerText = totalPieces * 15;
            document.getElementById('homeTotalButtons').innerText = totalPieces * 5;
            document.getElementById('buttonLabTotal').innerText = totalPieces + ' قطعة';

            // تحديث جدول حسابات الخياطين
            const tailorsBody = document.getElementById('tailorsSummaryBody');
            tailorsBody.innerHTML = '';
            tailorsList.forEach(t => {
                const count = tailorsTotals[t];
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="p-3 font-semibold text-slate-700">${t}</td>
                    <td class="p-3">${count} قطعة</td>
                    <td class="p-3 text-amber-600 font-bold">${count * 15}</td>
                `;
                tailorsBody.appendChild(tr);
            });

            localStorage.setItem('tailor_records', JSON.stringify(records));
        }

        form.addEventListener('submit', (e) => {
            e.preventDefault();
            const date = document.getElementById('entryDate').value;
            const tailor = document.getElementById('tailorName').value;
            const pieces = document.getElementById('piecesCount').value;

            records.push({ date, tailor, pieces });
            form.reset();
            document.getElementById('entryDate').valueAsDate = new Date();
            updateUI();
        });

        function deleteRecord(index) {
            records.splice(index, 1);
            updateUI();
        }

        function clearData() {
            if (confirm('هل أنت متأكد من مسح كافة السجلات؟')) {
                records = [];
                updateUI();
            }
        }

        document.getElementById('entryDate').valueAsDate = new Date();
        updateUI();
    </script>
</body>
</html>
